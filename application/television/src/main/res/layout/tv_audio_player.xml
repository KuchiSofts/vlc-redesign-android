<?xml version="1.0" encoding="utf-8"?>
<!-- VLC Redesign: the TV audio player as the design's music player (Figma 4767:23726 "Player - Music", the TV app's
     .pl.music) at the design's sizes (1 design px = 0.5 dp on a 1080p TV): the top bar, the large centred cover over its
     dimmed blur, the title and the artist under it, the control
     bar at the bottom as the video player's (previous, the accent play pill, next, the time, the seek well, the length,
     shuffle, repeat, the queue, more). The queue opens on demand on a dark panel at the end (Back or Left closes it).
     With the D-pad: Right from Next reaches the seek well (Left / Right seek), Up from it goes back to Play, Down to
     the buttons at the end. -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
                name="progress"
                type="androidx.lifecycle.LiveData&lt;org.videolan.vlc.viewmodels.PlaybackProgress>" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/rd_dark_bg_b1">

        <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/background"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:srcCompat="@tools:sample/backgrounds/scenic" />

        <!-- the top bar (Figma: 40 px, the cone, the title centred in FG/A2 14 px, the clock for the window buttons) -->
        <View
                android:id="@+id/rd_audio_top"
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:background="@color/rd_dark_bg_a3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="6.5dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_icon"
                app:layout_constraintBottom_toBottomOf="@+id/rd_audio_top"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/rd_audio_top" />

        <TextView
                android:id="@+id/top_title"
                android:layout_width="500dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/inter"
                android:gravity="center"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textColor="@color/rd_dark_fg_a2"
                android:textSize="7sp"
                app:layout_constraintBottom_toBottomOf="@+id/rd_audio_top"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/rd_audio_top" />

        <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:fontFamily="@font/inter"
                android:includeFontPadding="false"
                android:textColor="@color/rd_dark_fg_a2"
                android:textSize="7sp"
                app:layout_constraintBottom_toBottomOf="@+id/rd_audio_top"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/rd_audio_top" />

        <!-- the cover: 738 px square at 591,73 (radius 20) -->
        <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/album_cover"
                android:layout_width="369dp"
                android:layout_height="369dp"
                android:layout_marginTop="36.5dp"
                android:background="@color/rd_dark_bg_b1"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_song_big"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        <!-- "title - artist" under the cover (Figma: 24 px, FG/A1, centred on 937) -->
        <TextView
                android:id="@+id/media_title"
                android:layout_width="0dp"
                android:layout_height="14.5dp"
                android:layout_marginStart="120dp"
                android:layout_marginTop="461dp"
                android:layout_marginEnd="120dp"
                android:ellipsize="end"
                android:fontFamily="@font/inter"
                android:gravity="center"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textColor="@color/rd_dark_fg_a1"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Title - Artist" />

        <TextView
                android:id="@+id/media_artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
                android:id="@+id/playback_speed_quick_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/tv_overscan_horizontal"
                android:layout_marginTop="@dimen/tv_overscan_vertical"
                android:background="@drawable/rd_tv_button_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:longClickable="true"
                android:nextFocusDown="@+id/button_play"
                android:padding="6dp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="visible">

            <ImageView
                    android:id="@+id/playback_speed_quick_action_image"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_speed" />

            <TextView
                    android:id="@+id/playback_speed_quick_action_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:textColor="@color/rd_dark_fg_2"
                    tools:text="2.0x" />
        </LinearLayout>

        <LinearLayout
                android:id="@+id/sleep_quick_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="@dimen/tv_overscan_vertical"
                android:background="@drawable/rd_tv_button_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:longClickable="true"
                android:nextFocusDown="@+id/button_play"
                android:padding="6dp"
                android:visibility="gone"
                app:layout_constraintStart_toEndOf="@+id/playback_speed_quick_action"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_goneMarginStart="@dimen/tv_overscan_horizontal"
                tools:visibility="visible">

            <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_sleep" />

            <TextView
                    android:id="@+id/sleep_quick_action_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:textColor="@color/rd_dark_fg_2"
                    tools:text="9:30AM" />

        </LinearLayout>

        <androidx.constraintlayout.widget.Barrier
                android:id="@+id/barrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="sleep_quick_action,playback_speed_quick_action" />

        <!-- the queue, on demand: a B2 panel at the end, from the top to the bar -->
        <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/playlist"
                android:layout_width="400dp"
                android:layout_height="0dp"
                android:background="@color/rd_tv_panel"
                android:clipToPadding="false"
                android:nextFocusLeft="@+id/button_queue"
                android:nextFocusRight="@+id/playlist"
                android:nextFocusUp="@+id/playlist"
                android:nextFocusDown="@+id/playlist"
                android:layout_marginTop="20dp"
                android:visibility="gone"
                app:layout_constraintBottom_toTopOf="@+id/rd_audio_bar"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="visible" />

        <androidx.appcompat.widget.ViewStubCompat
                android:id="@+id/bookmarks_stub"
                android:layout_width="500dp"
                android:layout_height="0dp"
                android:layout="@layout/bookmarks"
                android:layout_marginTop="@dimen/tv_overscan_vertical"
                android:layout_marginBottom="8dp"
                app:layout_constraintBottom_toTopOf="@id/rd_audio_bar"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        <!-- the control bar (.pl.music .pl-bar): 54 px, A4 at 95 %, the line of A1 on top; zones 20 px from the sides,
             the buttons 28 px square 10 px apart (14 at the end), the play pill 54 x 28 -->
        <View
                android:id="@+id/rd_audio_bar"
                android:layout_width="0dp"
                android:layout_height="27dp"
                android:background="@drawable/rd_tv_audio_bar"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/button_previous"
                style="@style/RdTvBarButton"
                android:contentDescription="@string/previous"
                android:layout_marginStart="10dp"
                app:layout_constraintStart_toStartOf="parent"
                android:onClick="onClick"
                app:layout_constraintBottom_toBottomOf="@+id/rd_audio_bar"
                app:layout_constraintTop_toTopOf="@+id/rd_audio_bar"
                app:srcCompat="@drawable/ic_player_previous" />

        <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/button_rewind"
                style="@style/RdTvBarButton"
                android:layout_marginStart="5dp"
                android:contentDescription="@string/air_action_rewind"
                android:onClick="onClick"
                app:layout_constraintBottom_toBottomOf="@+id/rd_audio_bar"
                app:layout_constraintStart_toEndOf="@+id/button_previous"
                app:layout_constraintTop_toTopOf="@+id/rd_audio_bar"
                app:srcCompat="@drawable/rd_ic_backward" />

        <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/button_play"
                android:layout_width="27dp"
                android:layout_height="14dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/rd_tv_play_pill"
                android:clickable="true"
                android:focusable="true"
                android:onClick="onClick"
                android:scaleType="fitXY"
                app:layout_constraintBottom_toBottomOf="@+id/rd_audio_bar"
                app:layout_constraintStart_toEndOf="@+id/button_rewind"
                app:layout_constraintTop_toTopOf="@+id/rd_audio_bar"
                app:srcCompat="@drawable/rd_tv_play_glyph">

            <requestFocus />
        </androidx.appcompat.widget.AppCompatImageView>

        <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/button_forward"
                style="@style/RdTvBarButton"
                android:layout_marginStart="5dp"
                android:contentDescription="@string/air_action_forward"
                android:onClick="onClick"
                app:layout_constraintBottom_toBottomOf="@+id/rd_audio_bar"
                app:layout_constraintStart_toEndOf="@+id/button_play"
                app:layout_constraintTop_toTopOf="@+id/rd_audio_bar"
                app:srcCompat="@drawable/rd_ic_forward" />

        <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/button_next"
                style="@style/RdTvBarButton"
                android:contentDescription="@string/next"
                android:layout_marginStart="5dp"
                android:nextFocusRight="@+id/media_progress"
                android:onClick="onClick"
                app:layout_constraintBottom_toBottomOf="@+id/rd_audio_bar"
                app:layout_constraintStart_toEndOf="@+id/button_forward"
                app:layout_constraintTop_toTopOf="@+id/rd_audio_bar"
                app:srcCompat="@drawable/ic_player_next" />

        <!-- the timeline: the times in boxes of 76 px (15 px, FG/A2), the well of 28 px between, 8 px from them -->
        <TextView
                android:id="@+id/media_time"
                android:layout_width="38dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/inter"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:text="@{progress.timeText}"
                android:textColor="@color/rd_dark_fg_a2"
                android:textSize="7.5sp"
                app:layout_constraintBottom_toBottomOf="@+id/rd_audio_bar"
                app:layout_constraintStart_toEndOf="@+id/button_next"
                app:layout_constraintTop_toTopOf="@+id/rd_audio_bar"
                tools:text="0:30" />

        <org.videolan.vlc.gui.view.AccessibleSeekBar
                android:id="@+id/media_progress"
                android:layout_width="0dp"
                android:layout_height="14dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/rd_tv_seek_focus"
                android:focusable="true"
                android:layoutDirection="ltr"
                android:max="@{(int)progress.length}"
                android:maxHeight="14dp"
                android:minHeight="14dp"
                android:nextFocusUp="@+id/button_play"
                android:nextFocusDown="@+id/button_shuffle"
                android:padding="0dp"
                android:progress="@{(int)progress.time}"
                android:progressDrawable="@drawable/rd_tv_seek_well"
                android:secondaryProgress="0"
                android:splitTrack="false"
                android:thumb="@drawable/rd_tv_seek_knob"
                android:thumbOffset="-1dp"
                app:layout_constraintBottom_toBottomOf="@+id/rd_audio_bar"
                app:layout_constraintEnd_toStartOf="@+id/media_length"
                app:layout_constraintStart_toEndOf="@+id/media_time"
                app:layout_constraintTop_toTopOf="@+id/rd_audio_bar" />

        <!-- the bookmarks' marks over the seek well -->
        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/bookmark_marker_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                app:layout_constraintBottom_toTopOf="@+id/media_progress"
                app:layout_constraintEnd_toEndOf="@+id/media_progress"
                app:layout_constraintStart_toStartOf="@+id/media_progress" />

        <TextView
                android:id="@+id/media_length"
                android:layout_width="38dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:fontFamily="@font/inter"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:text="@{progress.lengthText}"
                android:textColor="@color/rd_dark_fg_a2"
                android:textSize="7.5sp"
                app:layout_constraintBottom_toBottomOf="@+id/rd_audio_bar"
                app:layout_constraintEnd_toStartOf="@+id/button_shuffle"
                app:layout_constraintTop_toTopOf="@+id/rd_audio_bar"
                tools:text="3:52" />

        <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/button_shuffle"
                style="@style/RdTvBarButton"
                android:contentDescription="@string/shuffle_title"
                android:layout_marginEnd="7dp"
                android:nextFocusLeft="@+id/media_progress"
                android:nextFocusUp="@+id/media_progress"
                app:layout_constraintEnd_toStartOf="@+id/button_repeat"
                android:onClick="onClick"
                app:layout_constraintBottom_toBottomOf="@+id/rd_audio_bar"
                app:layout_constraintTop_toTopOf="@+id/rd_audio_bar"
                app:srcCompat="@drawable/ic_shuffle_audio" />

        <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/button_repeat"
                style="@style/RdTvBarButton"
                android:layout_marginEnd="7dp"
                android:nextFocusUp="@+id/media_progress"
                app:layout_constraintEnd_toStartOf="@+id/button_queue"
                android:onClick="onClick"
                app:layout_constraintBottom_toBottomOf="@+id/rd_audio_bar"
                app:layout_constraintTop_toTopOf="@+id/rd_audio_bar"
                app:srcCompat="@drawable/ic_repeat_audio" />

        <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/button_queue"
                style="@style/RdTvBarButton"
                android:contentDescription="@string/show_playlist"
                android:layout_marginEnd="7dp"
                android:nextFocusUp="@+id/media_progress"
                app:layout_constraintEnd_toStartOf="@+id/button_more"
                android:onClick="onClick"
                app:layout_constraintBottom_toBottomOf="@+id/rd_audio_bar"
                app:layout_constraintTop_toTopOf="@+id/rd_audio_bar"
                app:srcCompat="@drawable/ic_player_playqueue" />

        <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/button_more"
                style="@style/RdTvBarButton"
                android:contentDescription="@string/more_actions"
                android:layout_marginEnd="10dp"
                android:nextFocusUp="@+id/media_progress"
                app:layout_constraintEnd_toEndOf="parent"
                android:onClick="onClick"
                app:layout_constraintBottom_toBottomOf="@+id/rd_audio_bar"
                app:layout_constraintTop_toTopOf="@+id/rd_audio_bar"
                app:srcCompat="@drawable/rd_tv_more" />

        <androidx.appcompat.widget.ViewStubCompat
                android:id="@+id/player_options_stub"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout="@layout/player_options"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
