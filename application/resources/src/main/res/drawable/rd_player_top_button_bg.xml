<?xml version="1.0" encoding="utf-8"?>
<!-- VLC Redesign (#10): a button of the player's top bar (cast, queue): the bar buttons' neutral pressed / focus
     square and the dim accent square while its panel is open, around the whole 36 dp button -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/rd_player_button_pressed">
    <item>
        <selector android:enterFadeDuration="120" android:exitFadeDuration="120">
            <!-- the keyboard / D-pad focus as the desktop's (and the TV app's): a 1 dp line of white on the square,
                 over the ON state's dim accent when both -->
            <item android:state_focused="true" android:state_activated="true">
                <shape android:shape="rectangle">
                    <corners android:radius="6dp" />
                    <solid android:color="@color/rd_player_active_bg" />
                    <stroke android:width="1dp" android:color="@android:color/white" />
                </shape>
            </item>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <corners android:radius="6dp" />
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="1dp" android:color="@android:color/white" />
                </shape>
            </item>
            <item android:state_activated="true">
                <shape android:shape="rectangle">
                    <corners android:radius="6dp" />
                    <solid android:color="@color/rd_player_active_bg" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="6dp" />
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
        </selector>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="@android:color/white" />
        </shape>
    </item>
</ripple>
