<?xml version="1.0" encoding="utf-8"?>
<!-- VLC Redesign: Settings > Video, the desktop's page (sections and wording of SettingsPresentation.qml).
     The rows keep the keys of the VLC Android settings; RdSettingsPage holds their behaviour. -->
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/rd_title_video">
    <PreferenceCategory android:title="@string/rd_sec_output">
        <org.videolan.vlc.gui.preferences.rd.RdListPreference
            android:defaultValue="-1"
            android:entries="@array/opengl_list"
            android:entryValues="@array/opengl_values"
            android:key="opengl"
            android:summary="@string/opengl_summary"
            android:title="@string/opengl_title" />
        <CheckBoxPreference
            android:defaultValue="false"
            android:key="video_match_frame_rate"
            android:summary="@string/video_match_frame_rate_summary"
            android:title="@string/video_match_frame_rate_title" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/rd_sec_deinterlacing">
        <org.videolan.vlc.gui.preferences.rd.RdListPreference
            android:key="rd_deinterlace"
            android:title="@string/rd_deinterlacing"
            android:summary="@string/rd_help_deinterlace"
            android:defaultValue="-1"
            android:entries="@array/rd_deinterlace_entries"
            android:entryValues="@array/rd_deinterlace_values" />
        <org.videolan.vlc.gui.preferences.rd.RdListPreference
            android:key="rd_deinterlace_mode"
            android:title="@string/rd_method"
            android:defaultValue="auto"
            android:entries="@array/rd_deinterlace_mode_entries"
            android:entryValues="@array/rd_deinterlace_mode_values" />
    </PreferenceCategory>
    <!-- the desktop's Framing: custom-aspect-ratios, added to the player's aspect ratio list (RdCustomAspect) -->
    <PreferenceCategory android:title="@string/rd_sec_framing">
        <org.videolan.vlc.gui.preferences.rd.RdEditTextPreference
            android:defaultValue=""
            android:key="rd_custom_aspect_ratios"
            android:summary="@string/rd_help_custom_aspect_ratios"
            android:title="@string/rd_custom_aspect_ratios" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/rd_sec_snapshots">
        <org.videolan.vlc.gui.preferences.rd.RdListPreference
            android:defaultValue="0"
            android:entries="@array/video_screenshot"
            android:entryValues="@array/video_screenshot_values"
            android:key="screenshot_mode"
            android:summary="%s"
            android:title="@string/enable_video_screenshot" />
        <!-- VLC Redesign: the desktop's Snapshots rows (gui/video/RdSnapshot) -->
        <org.videolan.vlc.gui.preferences.rd.RdListPreference
            android:defaultValue="screenshots"
            android:entries="@array/rd_snapshot_dir_entries"
            android:entryValues="@array/rd_snapshot_dir_values"
            android:key="rd_snapshot_dir"
            android:summary="%s"
            android:title="@string/rd_save_to" />
        <org.videolan.vlc.gui.preferences.rd.RdEditTextPreference
            android:defaultValue="vlc_"
            android:key="rd_snapshot_prefix"
            android:title="@string/rd_file_name_prefix" />
        <org.videolan.vlc.gui.preferences.rd.RdSegmentedPreference
            android:defaultValue="jpg"
            android:entries="@array/rd_snapshot_format_entries"
            android:entryValues="@array/rd_snapshot_format_values"
            android:key="rd_snapshot_format"
            android:title="@string/rd_format" />
        <org.videolan.vlc.gui.preferences.rd.RdEditTextPreference
            android:defaultValue=""
            android:key="rd_snapshot_width"
            android:summary="@string/rd_help_snapshot_width"
            android:title="@string/rd_snapshot_size" />
        <org.videolan.vlc.gui.preferences.rd.RdEditTextPreference
            android:defaultValue=""
            android:key="rd_snapshot_height"
            android:summary="@string/rd_help_snapshot_height"
            android:title="@string/rd_snapshot_height" />
        <CheckBoxPreference
            android:defaultValue="false"
            android:key="rd_snapshot_sequential"
            android:title="@string/rd_number_sequentially" />
        <CheckBoxPreference
            android:defaultValue="true"
            android:key="rd_snapshot_preview"
            android:title="@string/rd_snapshot_preview" />
    </PreferenceCategory>
    <!-- VLC Redesign: the desktop's Recording page, its folder (PlayerOptionsDelegate) -->
    <PreferenceCategory android:title="@string/rd_sec_recording">
        <org.videolan.vlc.gui.preferences.rd.RdListPreference
            android:defaultValue="movies"
            android:entries="@array/rd_record_dir_entries"
            android:entryValues="@array/rd_record_dir_values"
            android:key="rd_record_dir"
            android:summary="%s"
            android:title="@string/rd_save_recordings_to" />
    </PreferenceCategory>
</androidx.preference.PreferenceScreen>
