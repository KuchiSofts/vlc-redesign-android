<?xml version="1.0" encoding="utf-8"?>
<!-- VLC Redesign: Settings > Subtitles, the desktop's page (sections and wording of SettingsPresentation.qml).
     The rows keep the keys of the VLC Android settings; RdSettingsPage holds their behaviour. -->
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/rd_title_subtitles">
    <PreferenceCategory android:title="@string/rd_sec_tracks_languages">
        <org.videolan.vlc.gui.preferences.rd.RdListPreference
            android:defaultValue=""
            android:key="subtitle_preferred_language"
            android:persistent="true"
            android:title="@string/rd_preferred_language" />
        <org.videolan.vlc.gui.preferences.rd.RdListPreference
            android:defaultValue=""
            android:entries="@array/subtitles_encoding_list"
            android:entryValues="@array/subtitles_encoding_values"
            android:key="subtitle_text_encoding"
            android:persistent="true"
            android:summary="%s"
            android:title="@string/rd_text_encoding" />
        <!-- VLC Redesign: the desktop's Enable subtitles (VLCOptions: spu) -->
        <CheckBoxPreference
            android:defaultValue="true"
            android:key="rd_spu"
            android:summary="@string/rd_help_spu"
            android:title="@string/rd_enable_subtitles" />
    </PreferenceCategory>
    <!-- VLC Redesign: the desktop's "Second Language & Online Subtitles" (SettingsSubtitleLanguages.qml), then the
         services asked online (OnlineSubtitles): four free ones without an account, and OpenSubtitles.com with the
         user's own free key, with where to get it -->
    <PreferenceCategory android:title="@string/rd_os_section">
        <org.videolan.vlc.gui.preferences.rd.RdListPreference
            android:key="rd_sub_second_language"
            android:persistent="true"
            android:title="@string/rd_os_second" />
        <CheckBoxPreference
            android:defaultValue="true"
            android:key="rd_sub_online_auto"
            android:summary="@string/rd_os_auto_help"
            android:title="@string/rd_os_auto_settings" />
        <!-- the second language shown above the first one (RdDualSubtitles): with a second language only -->
        <CheckBoxPreference
            android:defaultValue="false"
            android:key="rd_sub_show_both"
            android:title="@string/rd_os_show_both" />
    </PreferenceCategory>
    <!-- the languages the services are asked for, each on or off, in the order of the results (RdSubtitleLanguages);
         "Every other language too" off: only those, a faster search -->
    <PreferenceCategory
        android:key="rd_sub_langs"
        android:title="@string/rd_os_langs">
        <Preference
            android:key="rd_sub_langs_add"
            android:persistent="false"
            android:title="@string/rd_os_add_language" />
        <CheckBoxPreference
            android:defaultValue="false"
            android:key="rd_sub_every_other"
            android:summary="@string/rd_os_fewer_faster"
            android:title="@string/rd_os_every_other" />
    </PreferenceCategory>
    <!-- one row per service, made by RdSubtitleServices (OnlineSubtitles.providers): its switch, its key or account
         (kept encrypted, out of the exported settings), Test or Sign in, Remove; Add a service brings one back -->
    <PreferenceCategory
        android:key="rd_sub_services"
        android:title="@string/rd_os_services">
        <Preference
            android:key="rd_sub_services_help"
            android:persistent="false"
            android:selectable="false"
            android:summary="@string/rd_os_services_help" />
        <Preference
            android:key="rd_sub_services_add"
            android:persistent="false"
            android:title="@string/rd_os_add_service"
            app:isPreferenceVisible="false" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/rd_sec_loading_subtitles">
        <CheckBoxPreference
            android:defaultValue="true"
            android:key="subtitles_autoload"
            android:title="@string/rd_load_subtitles_auto" />
        <org.videolan.vlc.gui.preferences.rd.RdListPreference
            android:key="rd_sub_fuzzy"
            android:title="@string/rd_file_name_matching"
            android:summary="@string/rd_help_fuzzy"
            android:defaultValue="3"
            android:entries="@array/rd_fuzzy_entries"
            android:entryValues="@array/rd_fuzzy_values" />
        <!-- VLC Redesign: the desktop's advanced row (VLCOptions: sub-autodetect-path, VLC's folders by default) -->
        <org.videolan.vlc.gui.preferences.rd.RdEditTextPreference
            android:defaultValue="./Subtitles, ./subtitles, ./Subs, ./subs"
            android:key="rd_sub_paths"
            android:summary="@string/rd_help_sub_paths"
            android:title="@string/rd_sub_paths" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/rd_sec_appearance">
        <org.videolan.vlc.gui.preferences.rd.RdListPreference
            android:defaultValue="-1"
            android:entries="@array/subtitles_presets_entries"
            android:entryValues="@array/subtitles_presets_values"
            android:key="subtitles_presets"
            android:persistent="false"
            android:title="@string/subtitles_presets_title" />
        <org.videolan.vlc.gui.preferences.rd.RdListPreference
            android:defaultValue="16"
            android:entries="@array/subtitles_size_entries"
            android:entryValues="@array/subtitles_size_values"
            android:key="subtitles_size"
            android:summary="%s"
            android:persistent="true"
            android:title="@string/rd_font_size" />
        <!-- VLC Redesign: the desktop's Font (freetype-font): the families Android's font list has -->
        <org.videolan.vlc.gui.preferences.rd.RdListPreference
            android:defaultValue=""
            android:entries="@array/rd_sub_font_entries"
            android:entryValues="@array/rd_sub_font_values"
            android:key="rd_sub_font"
            android:summary="%s"
            android:title="@string/rd_font" />
        <CheckBoxPreference
            android:defaultValue="false"
            android:key="subtitles_bold"
            android:title="@string/rd_bold" />
        <com.jaredrummler.android.colorpicker.ColorPreferenceCompat
            android:defaultValue="@color/white"
            android:key="subtitles_color"
            android:title="@string/rd_text_color" />
        <SeekBarPreference
            android:defaultValue="255"
            android:iconSpaceReserved="false"
            android:key="subtitles_color_opacity"
            android:max="255"
            android:title="@string/rd_text_opacity"
            app:min="50" />
        <CheckBoxPreference
            android:defaultValue="true"
            android:key="subtitles_outline"
            android:title="@string/subtitles_outline_title" />
        <org.videolan.vlc.gui.preferences.rd.RdListPreference
            android:defaultValue="4"
            android:entries="@array/subtitles_outline_size_entries"
            android:entryValues="@array/subtitles_outline_size_values"
            android:key="subtitles_outline_size"
            android:summary="%s"
            android:persistent="true"
            android:title="@string/rd_outline_thickness" />
        <com.jaredrummler.android.colorpicker.ColorPreferenceCompat
            android:defaultValue="@color/black"
            android:key="subtitles_outline_color"
            app:isPreferenceVisible="false"
            android:title="@string/rd_outline_color" />
        <SeekBarPreference
            android:defaultValue="255"
            android:key="subtitles_outline_color_opacity"
            app:isPreferenceVisible="false"
            android:max="255"
            android:title="@string/rd_outline_opacity"
            app:min="0" />
        <CheckBoxPreference
            android:defaultValue="true"
            android:key="subtitles_shadow"
            android:title="@string/rd_shadow" />
        <com.jaredrummler.android.colorpicker.ColorPreferenceCompat
            android:defaultValue="@color/black"
            android:key="subtitles_shadow_color"
            app:isPreferenceVisible="false"
            android:title="@string/rd_shadow_color" />
        <SeekBarPreference
            android:defaultValue="128"
            android:key="subtitles_shadow_color_opacity"
            app:isPreferenceVisible="false"
            android:max="255"
            android:title="@string/rd_shadow_opacity"
            app:min="0" />
        <SeekBarPreference
            android:key="rd_shadow_distance"
            android:title="@string/rd_shadow_distance"
            android:summary="@string/rd_help_shadow_distance"
            android:defaultValue="6"
            android:max="20"
            app:min="0"
            app:showSeekBarValue="true"
            android:dependency="subtitles_shadow" />
        <!-- VLC Redesign: the desktop's advanced rows of Appearance (VLCOptions: freetype-shadow-angle,
             freetype-text-direction, subsdec-align) -->
        <SeekBarPreference
            android:key="rd_shadow_angle"
            android:title="@string/rd_shadow_angle"
            android:defaultValue="-45"
            android:max="180"
            app:min="-180"
            app:seekBarIncrement="15"
            app:showSeekBarValue="true"
            android:dependency="subtitles_shadow" />
        <org.videolan.vlc.gui.preferences.rd.RdListPreference
            android:defaultValue="2"
            android:entries="@array/rd_text_direction_entries"
            android:entryValues="@array/rd_text_direction_values"
            android:key="rd_text_direction"
            android:summary="%s"
            android:title="@string/rd_text_direction" />
        <org.videolan.vlc.gui.preferences.rd.RdListPreference
            android:defaultValue="-1"
            android:entries="@array/rd_sub_align_entries"
            android:entryValues="@array/rd_sub_align_values"
            android:key="rd_sub_align"
            android:summary="%s"
            android:title="@string/rd_text_alignment" />
        <CheckBoxPreference
            android:defaultValue="false"
            android:key="subtitles_background"
            android:title="@string/rd_background" />
        <com.jaredrummler.android.colorpicker.ColorPreferenceCompat
            android:defaultValue="@color/black"
            android:key="subtitles_background_color"
            android:title="@string/rd_background_color" />
        <SeekBarPreference
            android:defaultValue="128"
            android:iconSpaceReserved="false"
            android:key="subtitles_background_color_opacity"
            android:max="255"
            android:title="@string/rd_background_opacity"
            app:min="0" />
        <SeekBarPreference
            android:key="rd_sub_margin"
            android:title="@string/rd_vertical_position"
            android:summary="@string/rd_help_sub_margin"
            android:defaultValue="0"
            android:max="200"
            app:min="0"
            app:showSeekBarValue="true" />
    </PreferenceCategory>
    <!-- VLC Redesign: the desktop's Timing section: the lines marked on the seek bar (gui/video/RdSeekCueMarks) -->
    <PreferenceCategory android:title="@string/rd_sec_timing">
        <!-- VLC Redesign: the desktop's Subtitle delay (sub-delay, -5 to +5 s in tenths): every video without a delay
             of its own starts with it (PlaylistManager.loadMediaMeta) -->
        <org.videolan.vlc.gui.preferences.rd.RdValueSeekBarPreference
            android:defaultValue="0"
            android:key="rd_sub_delay"
            android:max="50"
            android:summary="%s"
            android:title="@string/rd_subtitle_delay"
            app:min="-50"
            app:seekBarIncrement="5"
            app:updatesContinuously="true" />
        <CheckBoxPreference
            android:defaultValue="true"
            android:key="rd_seek_sub_cues"
            android:summary="@string/rd_help_seek_sub_cues"
            android:title="@string/rd_seek_sub_cues" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/rd_sec_osd">
        <!-- VLC Redesign: the desktop's Show feedback for shortcuts (osd) and Show feedback for (osd-duration, in
             tenths of a second here: 0.5 to 5 s as the desktop's slider, VLC's 1 s), gui/video/RdOsd -->
        <CheckBoxPreference
            android:defaultValue="true"
            android:key="rd_osd"
            android:summary="@string/rd_help_osd"
            android:title="@string/rd_show_shortcut_feedback" />
        <org.videolan.vlc.gui.preferences.rd.RdValueSeekBarPreference
            android:defaultValue="10"
            android:dependency="rd_osd"
            android:key="rd_osd_duration"
            android:max="50"
            android:summary="%s"
            android:title="@string/rd_show_feedback_for"
            app:min="5"
            app:seekBarIncrement="5"
            app:updatesContinuously="true" />
        <CheckBoxPreference
            android:key="rd_video_title"
            android:title="@string/rd_show_filename"
            android:summary="@string/rd_help_video_title"
            android:defaultValue="false" />
        <!-- VLC Redesign: the desktop's Show filename for (video-title-timeout, 1 to 10 s, VLC's 5 s) and Position
             of the filename (video-title-position, at the top as the desktop: clear of the subtitles) -->
        <org.videolan.vlc.gui.preferences.rd.RdValueSeekBarPreference
            android:defaultValue="5"
            android:dependency="rd_video_title"
            android:key="rd_video_title_timeout"
            android:max="10"
            android:summary="%s"
            android:title="@string/rd_show_filename_for"
            app:min="1"
            app:seekBarIncrement="1"
            app:updatesContinuously="true" />
        <org.videolan.vlc.gui.preferences.rd.RdListPreference
            android:defaultValue="4"
            android:dependency="rd_video_title"
            android:entries="@array/rd_title_position_entries"
            android:entryValues="@array/rd_title_position_values"
            android:key="rd_video_title_position"
            android:summary="%s"
            android:title="@string/rd_filename_position" />
    </PreferenceCategory>
</androidx.preference.PreferenceScreen>
