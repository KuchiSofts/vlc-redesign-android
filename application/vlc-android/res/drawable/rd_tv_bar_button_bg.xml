<?xml version="1.0" encoding="utf-8"?>
<!-- VLC Redesign: a 28 x 28 px button of the TV players' bar (the TV app's .pl-btn): the desktop's keyboard focus, a
     1 px line of white on its rounded square (radius 6 px); the accent's 25 % under an open panel's button -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_activated="true">
        <shape><solid android:color="@color/rd_tv_focus" /><stroke android:width="0.5dp" android:color="@android:color/white" /><corners android:radius="3dp" /></shape>
    </item>
    <item android:state_activated="true"><shape><solid android:color="@color/rd_tv_focus" /><corners android:radius="3dp" /></shape></item>
    <item android:state_focused="true">
        <shape><stroke android:width="0.5dp" android:color="@android:color/white" /><corners android:radius="3dp" /></shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
