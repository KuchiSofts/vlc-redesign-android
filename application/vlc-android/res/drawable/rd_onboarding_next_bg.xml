<?xml version="1.0" encoding="utf-8"?>
<!-- OnboardingButton.qml, primary: the accent, radius 6 (pressed: the dim accent) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape><solid android:color="?attr/rd_accent_dim" /><corners android:radius="6dp" /></shape></item>
    <item><shape><solid android:color="?attr/colorPrimary" /><corners android:radius="6dp" /></shape></item>
</selector>
