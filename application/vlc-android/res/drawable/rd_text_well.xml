    <item android:state_focused="true"><shape><solid android:color="?attr/rd_well" /><stroke android:width="2dp" android:color="?attr/rd_accent_dim" /><corners android:radius="6dp" /></shape></item>
    <item><shape><solid android:color="?attr/rd_well" /><stroke android:width="2dp" android:color="@color/rd_bg_a4" /><corners android:radius="6dp" /></shape></item>
</selector>