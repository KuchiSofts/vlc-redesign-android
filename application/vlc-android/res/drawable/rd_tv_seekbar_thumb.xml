<?xml version="1.0" encoding="utf-8"?>
<!-- VLC Redesign: the TV seek handle, 8 x 24 in the accent (FG/1 while the D-pad is on the well) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="3dp" />
            <solid android:color="@color/rd_dark_fg_1" />
            <size android:width="8dp" android:height="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="3dp" />
            <solid android:color="@color/rd_accent_orange_main" />
            <size android:width="8dp" android:height="24dp" />
        </shape>
    </item>
</selector>
