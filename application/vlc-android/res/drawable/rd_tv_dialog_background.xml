<?xml version="1.0" encoding="utf-8"?>
<!-- VLC Redesign: a dialog over the TV layout, the design's dialog panel (BG/A4, radius 14) in the 1 px window border,
     always in the dark palette (rd_dialog_background follows the phone's theme) -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
        android:insetLeft="24dp" android:insetRight="24dp" android:insetTop="40dp" android:insetBottom="40dp">
    <shape android:shape="rectangle">
        <solid android:color="@color/rd_dark_bg_a4" />
        <corners android:radius="14dp" />
        <stroke android:width="1dp" android:color="@color/rd_dark_window_border_token" />
    </shape>
</inset>
