<?xml version="1.0" encoding="utf-8"?>
<!--
  The VLC Redesign design system (Juxtopposed's "VLC Redesign (Community)" Figma file, CC BY 4.0) applied to the
  Android components. Values come from design/tokens.json of the desktop repository (see
  buildsystem/redesign/import_design.py): Inter, 14 for the interface text, 12 small, 15 the player controls,
  16 the section titles; radii 6 (controls), 10 (menus), 12 (cards), 14 (panels).
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <color name="rd_ripple_dark">#14FFFFFF</color>
    <color name="rd_ripple_light">#14000000</color>

    <!-- Text -->
    <style name="TextAppearance.Redesign.Headline4" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="fontFamily">@font/inter_light</item>
        <item name="android:fontFamily">@font/inter_light</item>
        <item name="android:textSize">32sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.Redesign.Headline5" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">24sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.Redesign.Headline6" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.Redesign.Subtitle1" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.Redesign.Subtitle2" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.Redesign.Body1" parent="TextAppearance.MaterialComponents.Body1">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.Redesign.Body2" parent="TextAppearance.MaterialComponents.Body2">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.Redesign.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.Redesign.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.Redesign.Overline" parent="TextAppearance.MaterialComponents.Overline">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <!-- Tabs: 14 Inter, sentence case, like the desktop view switches. -->
    <style name="TextAppearance.Redesign.Tab" parent="TextAppearance.Design.Tab">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">14sp</item>
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <!-- The bottom navigation labels: 12 Inter, the same size checked or not. -->
    <style name="TextAppearance.Redesign.Nav" parent="TextAppearance.MaterialComponents.Caption">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <!-- The player times: Inter 15 (fontControl), tabular figures so they do not move. -->
    <style name="TextAppearance.Redesign.Time" parent="TextAppearance.AppCompat">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <!-- Shapes -->
    <style name="ShapeAppearance.Redesign.Small" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">6dp</item>
    </style>
    <style name="ShapeAppearance.Redesign.Medium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>
    <style name="ShapeAppearance.Redesign.Large" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>
    <style name="ShapeAppearance.Redesign.Card" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <!-- Buttons (RedesignButton.qml, Figma "Cancel" / "Save"): radius 6, Inter SemiBold 14, sentence case; the
         accent button on the accent's background with the accent text, the neutral one on A3 in the window border.
         36 high (the desktop's 32 and a little more for a finger). -->
    <style name="Widget.Redesign.Button" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:textAppearance">@style/TextAppearance.Redesign.Button</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:minWidth">100dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">6dp</item>
        <item name="backgroundTint">@color/rd_button_primary_bg</item>
        <item name="android:textColor">@color/rd_button_primary_text</item>
        <item name="rippleColor">@color/rd_ripple_dark</item>
        <item name="elevation">0dp</item>
    </style>
    <style name="Widget.Redesign.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAppearance">@style/TextAppearance.Redesign.Button</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">6dp</item>
        <item name="backgroundTint">@color/rd_button_neutral_bg</item>
        <item name="strokeColor">@color/rd_window_border_token</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/rd_button_neutral_text</item>
        <item name="rippleColor">@color/rd_ripple_dark</item>
    </style>
    <!-- The buttons of the player's panels: always on the dark panel, 36 high, 13 Inter. -->
    <style name="Widget.Redesign.Button.Outlined.Player">
        <item name="android:minHeight">36dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textSize">13sp</item>
        <!-- two lines rather than an ellipsis: the side sheet in landscape and long translations are narrow -->
        <item name="android:maxLines">3</item>
        <item name="android:singleLine">false</item>
        <item name="android:ellipsize">none</item>
        <!-- long German words hyphenated rather than broken anywhere (a line was cut at font 1.3) -->
        <item name="android:hyphenationFrequency">normal</item>
        <item name="android:breakStrategy">high_quality</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="backgroundTint">@color/rd_player_button_bg</item>
        <item name="strokeColor">@color/rd_player_button_stroke</item>
        <item name="android:textColor">@color/rd_player_button_text</item>
        <item name="rippleColor">@color/rd_ripple_dark</item>
    </style>
    <style name="Widget.Redesign.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textAppearance">@style/TextAppearance.Redesign.Button</item>
        <item name="cornerRadius">6dp</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>
    <style name="Widget.Redesign.FAB" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Redesign.Fab</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="tint">?attr/colorOnPrimary</item>
        <item name="elevation">4dp</item>
    </style>
    <style name="ShapeAppearance.Redesign.Fab" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <!-- The toolbar overflow: the desktop's horizontal "more". -->
    <style name="Widget.Redesign.Overflow" parent="Widget.AppCompat.ActionButton.Overflow">
        <item name="srcCompat">@drawable/rd_nav_more</item>
        <item name="android:src">@drawable/rd_nav_more</item>
    </style>

    <!-- Menus (2107:5903 "context menu"): A4 panel, radius 10, rows of 48, 14 Inter in FG/A2. -->
    <style name="Widget.Redesign.PopupMenu" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@drawable/rd_menu_background</item>
        <item name="android:popupElevation">8dp</item>
    </style>

    <!-- Dialogs: the panel (radius 14, A4, the 1 px window border), title 16, buttons in the accent. -->
    <style name="ThemeOverlay.Redesign.Dialog.Dark" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <!-- colorPrimary / colorSecondary: the window's (the accent chosen in Settings) -->
        <item name="colorSurface">@color/rd_dark_bg_a4</item>
        <item name="colorOnSurface">@color/rd_dark_fg_1</item>
        <item name="android:textColorPrimary">@color/rd_dark_fg_1</item>
        <item name="android:textColorSecondary">@color/rd_dark_fg_a1</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Redesign.Large</item>
        <item name="materialAlertDialogTitleTextStyle">@style/Redesign.DialogTitle</item>
        <!-- the dialog panel in the 1 px window border -->
        <item name="android:windowBackground">@drawable/rd_dialog_background</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Redesign.Button.Text</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Redesign.Button.Text</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Redesign.Button.Text</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
    </style>
    <style name="ThemeOverlay.Redesign.Dialog.Light" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <!-- colorPrimary / colorSecondary: the window's (the accent chosen in Settings) -->
        <item name="colorSurface">@color/rd_light_bg_a4</item>
        <item name="colorOnSurface">@color/rd_light_fg_1</item>
        <item name="android:textColorPrimary">@color/rd_light_fg_1</item>
        <item name="android:textColorSecondary">@color/rd_light_fg_a1</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Redesign.Large</item>
        <item name="materialAlertDialogTitleTextStyle">@style/Redesign.DialogTitle</item>
        <!-- the dialog panel in the 1 px window border -->
        <item name="android:windowBackground">@drawable/rd_dialog_background</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Redesign.Button.Text</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Redesign.Button.Text</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Redesign.Button.Text</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
    </style>
    <style name="Redesign.DialogTitle" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textAppearance">@style/TextAppearance.Redesign.Headline6</item>
    </style>

    <!-- Snackbars: the menu panel (A4, radius 10, the 1 px window border), text FG/1, the action in the accent. -->
    <style name="Widget.Redesign.Snackbar" parent="Widget.MaterialComponents.Snackbar">
        <item name="android:background">@drawable/rd_snackbar_background</item>
        <item name="backgroundTint">@null</item>
        <item name="android:layout_margin">8dp</item>
        <item name="elevation">6dp</item>
        <!-- Material dims the action to half its colour: the design shows it in the full accent -->
        <item name="actionTextColorAlpha">1</item>
    </style>
    <style name="Widget.Redesign.Snackbar.Text" parent="Widget.MaterialComponents.Snackbar.TextView">
        <item name="android:textColor">@color/rd_fg_1</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Widget.Redesign.Snackbar.Button" parent="Widget.MaterialComponents.Button.TextButton.Snackbar">
        <item name="android:textColor">@color/rd_accent_text_theme</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textAppearance">@style/TextAppearance.Redesign.Button</item>
    </style>

    <!-- The library header: "N items" and the like (12, FG/A1). -->
    <style name="Redesign.Text.Small" parent="VLC.TextView">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/font_light</item>
    </style>

    <!-- The rows of the More page: 52 high, the design glyph, Inter 15 in FG/1, the chevron at the end. -->
    <style name="Redesign.MoreRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:drawablePadding">16dp</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/rd_fg_1</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="drawableEndCompat">@drawable/rd_ic_chevron_right</item>
    </style>
    <style name="Redesign.MoreDivider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">56dp</item>
        <item name="android:background">@color/rd_divider_dim</item>
    </style>

    <!-- Text fields (RedesignTextArea.qml): the B2 well, radius 6, no Material outline or underline, Inter 14;
         the label above in the accent while typing. Every TextInputLayout of the app without its own style. -->
    <style name="Widget.Redesign.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">?attr/rd_well</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="boxCornerRadiusTopStart">6dp</item>
        <item name="boxCornerRadiusTopEnd">6dp</item>
        <item name="boxCornerRadiusBottomStart">6dp</item>
        <item name="boxCornerRadiusBottomEnd">6dp</item>
        <item name="hintTextColor">?attr/colorPrimary</item>
        <item name="android:textColorHint">?android:attr/textColorTertiary</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.Redesign.TextInput</item>
    </style>
    <style name="ThemeOverlay.Redesign.TextInput" parent="ThemeOverlay.MaterialComponents.TextInputEditText.FilledBox">
        <item name="editTextStyle">@style/Widget.Redesign.TextInputEditText</item>
    </style>
    <style name="Widget.Redesign.TextInputEditText" parent="Widget.MaterialComponents.TextInputEditText.FilledBox">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <!-- Spinners as the desktop's dropdown: the well, the menu panel for the list, Inter 14 in FG/A2 -->
    <style name="Widget.Redesign.Spinner" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@drawable/rd_spinner_bg</item>
        <item name="android:popupBackground">@drawable/rd_menu_background</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">32dp</item>
        <item name="android:dropDownVerticalOffset">4dp</item>
    </style>
    <style name="Widget.Redesign.SpinnerItem" parent="Widget.AppCompat.TextView.SpinnerItem">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/rd_fg_a2</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
    </style>
    <style name="Widget.Redesign.DropDownItem" parent="Widget.AppCompat.DropDownItem.Spinner">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/rd_fg_a2</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
    </style>

    <!-- The equalizer presets as the desktop's segmented choices (flat on the well, the chosen one on A2 in the accent) -->
    <style name="ThemeOverlay.Redesign.ChoiceChip" parent="">
        <item name="chipStyle">@style/Widget.Redesign.ChoiceChip</item>
    </style>
    <style name="Widget.Redesign.ChoiceChip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipSurfaceColor">@android:color/transparent</item>
        <item name="chipBackgroundColor">@color/rd_choice_chip_bg</item>
        <item name="android:textColor">@color/rd_pref_choice_text_checked</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">4dp</item>
        <item name="chipMinHeight">30dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipIconVisible">false</item>
        <item name="ensureMinTouchTargetSize">false</item>
        <item name="rippleColor">@color/rd_ripple_dark</item>
        <item name="android:textAppearance">@style/TextAppearance.Redesign.Body1</item>
    </style>
</resources>