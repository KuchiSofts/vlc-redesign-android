<?xml version="1.0" encoding="utf-8"?>
<!-- VLC Redesign: the choices of the settings pages, as the desktop's (SettingsPresentation.qml) -->
<resources>
    <!-- The button text of RdActionPreference (SettingsActionRow.qml) -->
    <declare-styleable name="RdActionPreference">
        <attr name="actionText" format="reference|string" />
    </declare-styleable>
    <!-- Theme: Dark, Light, System (app_theme values 2, 1, -1) -->
    <string-array name="rd_theme_entries" translatable="false">
        <item>@string/rd_dark</item>
        <item>@string/rd_light</item>
        <item>@string/rd_system</item>
    </string-array>
    <string-array name="rd_theme_values" translatable="false">
        <item>2</item>
        <item>1</item>
        <item>-1</item>
    </string-array>
    <!-- deinterlace: -1 Automatic, 0 Off, 1 On -->
    <!-- #72: what a key or the remote shows in the player -->
    <string-array name="rd_fs_entries" translatable="false">
        <item>@string/rd_fs_show_controls</item>
        <item>@string/rd_fs_show_progress</item>
        <item>@string/rd_fs_show_message</item>
    </string-array>
    <string-array name="rd_fs_values" translatable="false">
        <item>controls</item>
        <item>progress</item>
        <item>message</item>
    </string-array>
    <string-array name="rd_deinterlace_entries" translatable="false">
        <item>@string/rd_automatic</item>
        <item>@string/rd_off</item>
        <item>@string/rd_on</item>
    </string-array>
    <string-array name="rd_deinterlace_values" translatable="false">
        <item>-1</item>
        <item>0</item>
        <item>1</item>
    </string-array>
    <!-- deinterlace-mode of VLC 3 (the names VLC shows) -->
    <string-array name="rd_deinterlace_mode_entries" translatable="false">
        <item>@string/rd_automatic</item>
        <item>Discard</item>
        <item>Blend</item>
        <item>Mean</item>
        <item>Bob</item>
        <item>Linear</item>
        <item>X</item>
        <item>Yadif</item>
        <item>Yadif (2x)</item>
        <item>Phosphor</item>
        <item>Film NTSC (IVTC)</item>
    </string-array>
    <string-array name="rd_deinterlace_mode_values" translatable="false">
        <item>auto</item>
        <item>discard</item>
        <item>blend</item>
        <item>mean</item>
        <item>bob</item>
        <item>linear</item>
        <item>x</item>
        <item>yadif</item>
        <item>yadif2x</item>
        <item>phosphor</item>
        <item>ivtc</item>
    </string-array>
    <!-- avi-index: 0 Ask, 1 Always, 2 Never, 3 When needed -->
    <string-array name="rd_avi_index_entries" translatable="false">
        <item>@string/rd_ask</item>
        <item>@string/rd_always</item>
        <item>@string/rd_never</item>
        <item>@string/rd_when_needed</item>
    </string-array>
    <string-array name="rd_avi_index_values" translatable="false">
        <item>0</item>
        <item>1</item>
        <item>2</item>
        <item>3</item>
    </string-array>
    <!-- sub-autodetect-fuzzy 0..4 (VLC's own texts) -->
    <string-array name="rd_fuzzy_entries" translatable="false">
        <item>@string/rd_fuzzy_0</item>
        <item>@string/rd_fuzzy_1</item>
        <item>@string/rd_fuzzy_2</item>
        <item>@string/rd_fuzzy_3</item>
        <item>@string/rd_fuzzy_4</item>
    </string-array>
    <string-array name="rd_fuzzy_values" translatable="false">
        <item>0</item>
        <item>1</item>
        <item>2</item>
        <item>3</item>
        <item>4</item>
    </string-array>
    <!-- postproc-q 0..6 -->
    <string-array name="rd_postproc_entries" translatable="false">
        <item>@string/rd_off</item>
        <item>1</item>
        <item>2</item>
        <item>3</item>
        <item>4</item>
        <item>5</item>
        <item>6</item>
    </string-array>
    <string-array name="rd_postproc_values" translatable="false">
        <item>0</item>
        <item>1</item>
        <item>2</item>
        <item>3</item>
        <item>4</item>
        <item>5</item>
        <item>6</item>
    </string-array>
    <!-- Idle screen (rd_idle_screen, the TV layout): Off, after 1, 3, 5 or 10 minutes (the TV app's) -->
    <string-array name="rd_idle_screen_entries" translatable="false">
        <item>@string/rd_off</item>
        <item>@string/rd_idle_after_1</item>
        <item>@string/rd_idle_after_3</item>
        <item>@string/rd_idle_after_5</item>
        <item>@string/rd_idle_after_10</item>
    </string-array>
    <string-array name="rd_idle_screen_values" translatable="false">
        <item>0</item>
        <item>1</item>
        <item>3</item>
        <item>5</item>
        <item>10</item>
    </string-array>
    <!-- Volume indicator (rd_volume_indicator): Automatic (by the direction of the language), the right or the left
         side, the top right or the top left corner (the desktop's choices) -->
    <string-array name="rd_volume_indicator_entries" translatable="false">
        <item>@string/rd_automatic</item>
        <item>@string/rd_volume_right_side</item>
        <item>@string/rd_volume_left_side</item>
        <item>@string/rd_volume_top_right</item>
        <item>@string/rd_volume_top_left</item>
    </string-array>
    <string-array name="rd_volume_indicator_values" translatable="false">
        <item>auto</item>
        <item>right</item>
        <item>left</item>
        <item>top_right</item>
        <item>top_left</item>
    </string-array>
    <!-- Subtitles › Appearance (advanced): freetype-text-direction 0 left to right, 1 right to left, 2 automatic -->
    <string-array name="rd_text_direction_entries" translatable="false">
        <item>@string/rd_ltr</item>
        <item>@string/rd_rtl</item>
        <item>@string/rd_automatic</item>
    </string-array>
    <string-array name="rd_text_direction_values" translatable="false">
        <item>0</item>
        <item>1</item>
        <item>2</item>
    </string-array>
    <!-- Subtitles › Appearance (advanced): subsdec-align -1 automatic, 0 center, 1 left, 2 right -->
    <string-array name="rd_sub_align_entries" translatable="false">
        <item>@string/rd_automatic</item>
        <item>@string/rd_zone_center</item>
        <item>@string/rd_left</item>
        <item>@string/rd_right</item>
    </string-array>
    <string-array name="rd_sub_align_values" translatable="false">
        <item>-1</item>
        <item>0</item>
        <item>1</item>
        <item>2</item>
    </string-array>
    <!-- Subtitles › On-Screen Messages: video-title-position (VLC's subpicture alignment flags) -->
    <string-array name="rd_title_position_entries" translatable="false">
        <item>@string/rd_zone_center</item>
        <item>@string/rd_left</item>
        <item>@string/rd_right</item>
        <item>@string/rd_fx_top</item>
        <item>@string/rd_fx_bottom</item>
        <item>@string/rd_top_left</item>
        <item>@string/rd_top_right</item>
        <item>@string/rd_bottom_left</item>
        <item>@string/rd_bottom_right</item>
    </string-array>
    <string-array name="rd_title_position_values" translatable="false">
        <item>0</item>
        <item>1</item>
        <item>2</item>
        <item>4</item>
        <item>8</item>
        <item>5</item>
        <item>6</item>
        <item>9</item>
        <item>10</item>
    </string-array>
    <!-- Audio › Effects: Spatial audio mode (the desktop's mix-mode 0 / 2; libvlc 3 spatialaudio-headphones) -->
    <string-array name="rd_mix_mode_entries" translatable="false">
        <item>@string/rd_automatic</item>
        <item>@string/rd_headphone_virtualization</item>
    </string-array>
    <string-array name="rd_mix_mode_values" translatable="false">
        <item>0</item>
        <item>2</item>
    </string-array>
    <!-- Audio › Output (advanced): force-dolby-surround 0 automatic, 1 on, 2 off -->
    <string-array name="rd_dolby_entries" translatable="false">
        <item>@string/rd_automatic</item>
        <item>@string/rd_on</item>
        <item>@string/rd_off</item>
    </string-array>
    <string-array name="rd_dolby_values" translatable="false">
        <item>0</item>
        <item>1</item>
        <item>2</item>
    </string-array>
    <!-- Audio › Output (advanced): soxr-resampler-quality 0 to 4 (VLC's 2) -->
    <string-array name="rd_soxr_entries" translatable="false">
        <item>@string/rd_fastest</item>
        <item>@string/rd_fast</item>
        <item>@string/rd_balanced</item>
        <item>@string/rd_high</item>
        <item>@string/rd_best</item>
    </string-array>
    <string-array name="rd_soxr_values" translatable="false">
        <item>0</item>
        <item>1</item>
        <item>2</item>
        <item>3</item>
        <item>4</item>
    </string-array>
    <!-- Network › Security: gnutls-priorities (VLC's NORMAL) -->
    <string-array name="rd_cipher_entries" translatable="false">
        <item>@string/rd_fastest</item>
        <item>@string/rd_balanced</item>
        <item>@string/rd_cipher_128</item>
        <item>@string/rd_cipher_256</item>
    </string-array>
    <string-array name="rd_cipher_values" translatable="false">
        <item>PERFORMANCE</item>
        <item>NORMAL</item>
        <item>SECURE128</item>
        <item>SECURE256</item>
    </string-array>
    <!-- Video › Recording: where Record writes (PlayerOptionsDelegate) -->
    <string-array name="rd_record_dir_entries" translatable="false">
        <item>@string/rd_record_dir_movies</item>
        <item>@string/rd_record_dir_downloads</item>
        <item>@string/rd_record_dir_app</item>
    </string-array>
    <string-array name="rd_record_dir_values" translatable="false">
        <item>movies</item>
        <item>downloads</item>
        <item>app</item>
    </string-array>
    <!-- Video › Snapshots: the folder (RdSnapshot.relativeDir) and the format -->
    <string-array name="rd_snapshot_dir_entries" translatable="false">
        <item>@string/rd_snapshot_dir_screenshots</item>
        <item>@string/rd_snapshot_dir_pictures</item>
        <item>@string/rd_snapshot_dir_dcim</item>
    </string-array>
    <string-array name="rd_snapshot_dir_values" translatable="false">
        <item>screenshots</item>
        <item>pictures</item>
        <item>dcim</item>
    </string-array>
    <string-array name="rd_snapshot_format_entries" translatable="false">
        <item>JPG</item>
        <item>PNG</item>
    </string-array>
    <string-array name="rd_snapshot_format_values" translatable="false">
        <item>jpg</item>
        <item>png</item>
    </string-array>
</resources>
