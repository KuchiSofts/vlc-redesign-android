<?xml version="1.0" encoding="utf-8"?>
<!-- VLC Redesign: the styles of the TV layout's own pages (the onboarding, the buttons, the dialogs, the details) -->
<resources>
    <!-- the TV layout's focus line (RdTvFocusRing): its listener on a window, a view's own foreground under it -->
    <item name="rd_tv_focus_listener" type="id" />
    <item name="rd_fit_listener" type="id" />
    <item name="rd_tv_focus_saved" type="id" />
    <item name="rd_tv_focus_skip" type="id" />
    <item name="rd_tv_mini" type="id" />
    <item name="rd_tv_titlebar" type="id" />
    <item name="rd_tv_title_menu" type="id" />
    <item name="rd_tv_title_text" type="id" />
    <item name="rd_tv_header" type="id" />
    <item name="rd_tv_header_back" type="id" />
    <item name="rd_tv_header_crumb" type="id" />
    <item name="rd_tv_header_count" type="id" />
    <item name="rd_tv_header_sort" type="id" />
    <item name="rd_tv_header_view" type="id" />
    <item name="rd_tv_header_more" type="id" />
    <item name="rd_tv_header_search" type="id" />
    <item name="rd_tv_header_search_text" type="id" />

    <!-- a neutral button: 40 high, Inter SemiBold 15, FG/A2 on #1B1B1B, the focus frame (rd_tv_button_bg) -->
    <style name="RdTvButton" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:minWidth">100dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:singleLine">true</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">@drawable/rd_tv_button_bg</item>
        <item name="android:textColor">@color/rd_tv_button_text</item>
    </style>

    <!-- the accent button: FG/B1 on the accent -->
    <style name="RdTvButton.Accent">
        <item name="android:background">@drawable/rd_tv_button_accent_bg</item>
        <item name="android:textColor">@color/rd_dark_fg_b1</item>
    </style>

    <!-- the onboarding's buttons on the TV at the design's size: 100 x 32 px, Inter SemiBold 16 px, FG/A2 (FG/B1 on the
         accent) -->
    <style name="RdTvObButton" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:minWidth">50dp</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:layout_height">16dp</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">8sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:singleLine">true</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">@drawable/rd_tv_ob_button_bg</item>
        <item name="android:textColor">@color/rd_dark_fg_a2</item>
    </style>

    <style name="RdTvObButton.Accent">
        <item name="android:background">@drawable/rd_tv_ob_button_accent_bg</item>
        <item name="android:textColor">@color/rd_dark_fg_b1</item>
    </style>

    <!-- a button of the TV players' bar at the design's size (the TV app's .pl-btn): 28 px square, the 24 px glyph -->
    <style name="RdTvBarButton" parent="">
        <item name="android:layout_width">14dp</item>
        <item name="android:layout_height">14dp</item>
        <item name="android:padding">1dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/rd_tv_bar_button_bg</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- an icon button of the TV music player's bar: 44 square, the 24 glyph, the desktop's focus line -->
    <style name="RdTvAudioButton" parent="">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/rd_tv_icon_button_bg</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- the system's alert dialogs over the TV layout: the design's dialog panel (A4, radius 14, the window border),
         Inter, the buttons in the accent with the accent's focus -->
    <style name="Theme.VLC.TV.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/rd_tv_dialog_background</item>
        <item name="android:colorBackground">@color/rd_dark_bg_a4</item>
        <item name="android:textColorPrimary">@color/rd_dark_fg_1</item>
        <item name="android:textColorSecondary">@color/rd_dark_fg_a1</item>
        <item name="android:textColorAlertDialogListItem">@color/rd_dark_fg_1</item>
        <item name="android:colorAccent">@color/rd_accent_orange_main</item>
        <item name="android:colorControlActivated">@color/rd_accent_orange_main</item>
        <item name="android:colorControlHighlight">@color/rd_tv_focus</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:buttonBarButtonStyle">@style/RdTvDialogButton</item>
    </style>

    <style name="RdTvDialogButton" parent="android:Widget.Material.Button.Borderless.Colored">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/rd_accent_orange_main</item>
    </style>

    <!-- Leanback's guided steps (the TV's confirmations): the B1 page, the A5 actions, Inter, the focused action in the
         accent's 25 % -->
    <style name="Theme.VLC.TV.GuidedStep" parent="Theme.Leanback.GuidedStep">
        <item name="android:fontFamily">@font/inter</item>
        <item name="guidedStepBackground">@color/tv_bg</item>
        <item name="guidedActionsBackground">@color/rd_dark_bg_a5</item>
        <item name="guidedActionsBackgroundDark">@color/rd_dark_bg_b2</item>
        <item name="guidanceTitleStyle">@style/RdTvGuidanceTitle</item>
        <item name="guidanceDescriptionStyle">@style/RdTvGuidanceDescription</item>
        <item name="guidedActionItemTitleStyle">@style/RdTvGuidedActionTitle</item>
        <item name="guidedActionsSelectorDrawable">@drawable/rd_tv_focus_selector</item>
    </style>

    <style name="RdTvGuidanceTitle" parent="Widget.Leanback.GuidanceTitleStyle">
        <item name="android:fontFamily">@font/inter_light</item>
        <item name="android:textColor">@color/rd_dark_fg_1</item>
    </style>

    <style name="RdTvGuidanceDescription" parent="Widget.Leanback.GuidanceDescriptionStyle">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">@color/rd_dark_fg_a1</item>
    </style>

    <style name="RdTvGuidedActionTitle" parent="Widget.Leanback.GuidedActionItemTitleStyle">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textColor">@color/rd_dark_fg_1</item>
    </style>

    <!-- the details pages (a media, a show): the dark palette, Inter, the actions as the design's buttons -->
    <style name="Theme.VLC.TV.Details" parent="Theme.Leanback.Details">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:windowBackground">@color/tv_bg</item>
        <item name="android:alertDialogTheme">@style/Theme.VLC.TV.Dialog</item>
        <item name="android:colorAccent">@color/rd_accent_orange_main</item>
        <item name="colorAccent">@color/rd_accent_orange_main</item>
        <item name="defaultBrandColor">@color/rd_dark_bg_b2</item>
        <item name="defaultBrandColorDark">@color/rd_dark_bg_b2</item>
        <item name="defaultSearchColor">@color/rd_accent_orange_main</item>
        <item name="defaultSearchIconColor">@color/rd_dark_fg_b1</item>
        <item name="detailsActionButtonStyle">@style/RdTvDetailsAction</item>
        <item name="detailsDescriptionTitleStyle">@style/RdTvDetailsTitle</item>
        <item name="imageCardViewStyle">@style/VLCardView</item>
        <item name="imageCardViewTitleStyle">@style/VLCardViewTitleStyle</item>
        <item name="imageCardViewInfoAreaStyle">@style/VLCardViewInfoStyle</item>
        <item name="imageCardViewContentStyle">@style/RdTvCardContent</item>
        <item name="rowHeaderStyle">@style/RdTvRowHeader</item>
    </style>

    <style name="RdTvDetailsAction" parent="Widget.Leanback.DetailsActionButtonStyle">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/rd_tv_button_text</item>
        <item name="android:background">@drawable/rd_tv_button_bg</item>
    </style>

    <style name="RdTvDetailsTitle" parent="Widget.Leanback.DetailsDescriptionTitleStyle">
        <item name="android:fontFamily">@font/inter_light</item>
    </style>
</resources>
