<?xml version="1.0" encoding="utf-8"?>
<!-- VLC Redesign: Settings > General > Follow the system accent color (the desktop's), Android 12 and later: the
     accent from the wallpaper's palette (Material You), applied as the nine others (UiTools.applyAccent).
     Light theme: the palette's darker tone for the main colour, its light tint as 'bright'. -->
<resources>
    <style name="ThemeOverlay.Redesign.Accent.System" parent="">
        <item name="colorPrimary">@android:color/system_accent1_600</item>
        <item name="colorSecondary">@android:color/system_accent1_600</item>
        <item name="colorAccent">@android:color/system_accent1_600</item>
        <item name="colorControlActivated">@android:color/system_accent1_600</item>
        <item name="rd_accent_bright">@android:color/system_accent1_200</item>
        <item name="rd_accent_dim">@android:color/system_accent1_700</item>
    </style>
    <style name="ThemeOverlay.Redesign.AccentDark.System" parent="ThemeOverlay.Redesign.Accent.System">
        <item name="colorPrimary">@android:color/system_accent1_400</item>
        <item name="colorSecondary">@android:color/system_accent1_400</item>
        <item name="colorAccent">@android:color/system_accent1_400</item>
        <item name="colorControlActivated">@android:color/system_accent1_400</item>
        <item name="rd_accent_bright">@android:color/system_accent1_300</item>
    </style>
</resources>
