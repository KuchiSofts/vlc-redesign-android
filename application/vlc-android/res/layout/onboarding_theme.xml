<?xml version="1.0" encoding="utf-8"?>
<!-- VLC Redesign: ThemeStep.qml (Figma 1902:3670): "Select your preferred theme and color.", Light, Dark and System
     (the chosen one ringed in the accent), the nine accent discs under them -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="24dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/theme_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_light"
            android:gravity="center"
            android:text="@string/rd_ob_theme_title"
            android:textColor="@color/rd_dark_fg_a1"
            android:textSize="22sp"
            android:accessibilityHeading="true" />

        <LinearLayout
            android:id="@+id/theme_tiles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/accent_discs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/themeDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:textColor="@color/rd_dark_fg_a3"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
