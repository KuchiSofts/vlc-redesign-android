<?xml version="1.0" encoding="utf-8"?>
<!--
  VLC Redesign: the series preset of the tracks panel (the desktop's SubtitleSeriesPreset): Remember for this
  series keeps the audio track, the subtitle track, the subtitle delay and size of the episodes of one series
  (S01E02... or one folder); the next episode opens with them. Under the switch: which series, or what was done.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="8dp"
        android:background="@color/rd_dark_divider_dim" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/rd_series_switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter"
        android:minHeight="40dp"
        android:text="@string/rd_series_remember"
        android:textAlignment="viewStart"
        android:textColor="@color/rd_dark_fg_1"
        android:textSize="14sp"
        app:switchPadding="8dp" />

    <TextView
        android:id="@+id/rd_series_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter"
        android:textAlignment="viewStart"
        android:textColor="@color/rd_dark_fg_a1"
        android:textSize="12sp" />
</LinearLayout>
</layout>
