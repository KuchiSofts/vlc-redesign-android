<?xml version="1.0" encoding="utf-8"?>
<!-- VLC Redesign: the desktop's welcome step "Subtitle languages" (SubtitleLanguagesStep.qml): the default language
     and the second one, used when a video has none in the first (OnboardingSubtitlesFragment) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/rd_onboarding_side"
        android:paddingEnd="@dimen/rd_onboarding_side"
        android:paddingTop="24dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/subtitles_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_light"
            android:gravity="center"
            android:text="@string/rd_ob_subtitles_title"
            android:textColor="@color/rd_dark_fg_a1"
            android:textSize="22sp"
            android:accessibilityHeading="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:maxWidth="560dp"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:text="@string/rd_ob_subtitles_text"
            android:textColor="@color/rd_dark_fg_a2"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/subtitles_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:maxWidth="560dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
