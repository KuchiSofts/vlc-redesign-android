<?xml version="1.0" encoding="utf-8"?>
<!-- VLC Redesign: the onboarding as the desktop's (OnboardingDialog.qml, Figma 1899:3055...): the dark B1 card, the
     step in the middle, Back and Next (in the accent; Finish on the last step) at the bottom end, Skip at the start -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/rd_dark_bg_b1"
        tools:context="org.videolan.vlc.gui.onboarding.OnboardingActivity">

    <FrameLayout
            android:id="@+id/fragment_onboarding_placeholder"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/next_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    <TextView
            android:id="@+id/skip_button"
            style="@style/Widget.Redesign.Onboarding.TextButton"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="16dp"
            android:text="@string/skip"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    <TextView
            android:id="@+id/back_button"
            style="@style/Widget.Redesign.Onboarding.Button"
            android:layout_marginEnd="8dp"
            android:background="@drawable/rd_onboarding_back_bg"
            android:text="@string/rd_back"
            android:textColor="@color/rd_dark_fg_a2"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/next_button"
            app:layout_constraintEnd_toStartOf="@id/next_button" />

    <TextView
            android:id="@+id/next_button"
            style="@style/Widget.Redesign.Onboarding.Button"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/rd_onboarding_next_bg"
            android:text="@string/rd_next"
            android:textColor="#FF0E0E0E"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
