<!-- VLC Redesign: the design's volume meter (RdVolumeMeter); its place is Settings > Controls > Volume
     indicator (VideoPlayerOverlayDelegate.showVolumeBar) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/player_overlay_volume"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:focusable="false"
        android:visibility="invisible"
        tools:visibility="visible">

    <org.videolan.vlc.gui.view.RdVolumeMeter
            android:id="@+id/player_volume_meter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

</FrameLayout>
