<?xml version="1.0" encoding="utf-8"?>
<!-- VLC Redesign: the desktop's last steps: what VLC does by itself (its online choices), then the credit of the
     interface's design, as the About page shows it -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/privacy_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_light"
            android:gravity="center"
            android:text="@string/rd_ob_online_title"
            android:textColor="@color/rd_dark_fg_a1"
            android:textSize="22sp"
            android:accessibilityHeading="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:maxWidth="560dp"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:text="@string/rd_ob_online_text"
            android:textColor="@color/rd_dark_fg_a2"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/privacy_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:maxWidth="560dp"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:maxWidth="560dp"
            android:background="@drawable/rd_onboarding_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/design_credit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_medium"
                android:textAlignment="viewStart"
                android:textColor="@color/rd_dark_fg_1"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/design_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/inter"
                android:text="@string/rd_about_design_source"
                android:textAlignment="viewStart"
                android:textColor="@color/rd_dark_fg_a2"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
