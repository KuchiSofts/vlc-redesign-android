<?xml version="1.0" encoding="utf-8"?>
<!-- VLC Redesign: a subtitle found online (the desktop's row of the online part of the subtitles panel): what it
     was made for (its release), then the service, "For this file", "For the hearing impaired", its downloads;
     "Downloading…" while it comes, a check mark once loaded. The whole row loads it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="6dp"
        android:paddingEnd="20dp"
        android:paddingBottom="6dp">

    <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

        <TextView
                android:id="@+id/rd_os_row_release"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:fontFamily="@font/inter"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:textDirection="firstStrong"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="14sp"
                tools:text="Sintel.2010.1080p.BluRay.x264" />

        <TextView
                android:id="@+id/rd_os_row_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter"
                android:maxLines="2"
                android:textAlignment="viewStart"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp"
                tools:text="OpenSubtitles · For this file · 12k downloads" />
    </LinearLayout>

    <ImageView
            android:id="@+id/rd_os_row_check"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="12dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_check"
            android:visibility="gone"
            tools:visibility="visible" />
</LinearLayout>
