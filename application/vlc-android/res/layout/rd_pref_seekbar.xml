<?xml version="1.0" encoding="utf-8"?>
<!-- VLC Redesign: a slider row of the settings (SettingsSlider.qml): the label and the value on one line, the slider
     under them, in the accent -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="52dp"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="4dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ImageView
        android:id="@android:id/icon"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@android:id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/inter"
            android:textSize="14sp"
            android:textColor="@color/rd_fg_a2"
            android:textAlignment="viewStart" />

        <TextView
            android:id="@+id/seekbar_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:minWidth="36dp"
            android:gravity="end"
            android:fontFamily="@font/inter"
            android:textSize="14sp"
            android:textColor="@color/rd_fg_2" />
    </LinearLayout>

    <TextView
        android:id="@android:id/summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/inter"
        android:textSize="12sp"
        android:textColor="@color/rd_fg_a3"
        android:maxLines="6"
        android:textAlignment="viewStart" />

    <SeekBar
        android:id="@+id/seekbar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:background="@null" />
</LinearLayout>
